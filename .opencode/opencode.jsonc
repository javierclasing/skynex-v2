{
  "$schema": "https://opencode.ai/config.json",

  "agent": {
    "coder": {
      "mode": "subagent",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          ".env": "deny",
          ".env.*": "deny",
          "**/.env": "deny",
          "**/.env.*": "deny",
          ".npmrc": "deny",
          "**/.npmrc": "deny",
          ".netrc": "deny",
          "**/.netrc": "deny",
          "*.pem": "deny",
          "**/*.pem": "deny",
          "*.key": "deny",
          "**/*.key": "deny",
          "credentials.json": "deny",
          "**/credentials.json": "deny",
          "*service-account*.json": "deny",
          "**/*service-account*.json": "deny",
          "**/.aws/**": "deny",
          "**/.ssh/**": "deny"
        },
        "external_directory": "deny",
        "glob": "allow",
        "grep": "allow",
        "edit": "allow",
        "bash": "ask",
        "task": "deny",
        "question": "deny"
      }
    },

